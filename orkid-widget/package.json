{
  "name": "@orkid-labs/widget",
  "version": "0.3.1",
  "description": "White-label React swap widget for the Orkid gasless swap API \u2014 embed MEV-protected DEX aggregation and Permit2 gasless token swaps in any React app",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build:css": "cat src/styles.css > dist/styles.css",
    "prepare": "npm run build && npm run build:css",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "orkid",
    "swap",
    "token-swap",
    "crypto-swap",
    "widget",
    "react",
    "react-component",
    "swap-widget",
    "dex",
    "dex-aggregator",
    "gasless",
    "permit2",
    "mev",
    "mev-protection",
    "base",
    "ethereum",
    "arbitrum",
    "polygon",
    "defi",
    "white-label",
    "embeddable",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orkid-labs/orkid-sdk.git",
    "directory": "orkid-widget"
  },
  "homepage": "https://docs.orkidlabs.xyz",
  "bugs": {
    "url": "https://github.com/orkid-labs/orkid-sdk/issues"
  },
  "peerDependencies": {
    "@orkid-labs/sdk": "^0.1.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "devDependencies": {
    "@orkid-labs/sdk": "file:../orkid-sdk",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "viem": "^2.41.0",
    "vitest": "^2.1.9",
    "wagmi": "^2.19.0"
  }
}
